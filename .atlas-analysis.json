  "keyFeatures": [
    "Anonymous peer-support group video sessions via LiveKit",
    "Separate user and professional (counselor) account flows",
    "Post-session audio transcription using Groq Whisper (whisper-large-v3)",
    "History-aware AI wellbeing trend analysis (improving / stable / declining)",
    "Private journal with opt-in inclusion in AI analysis context",
    "Progress tracking with trend visualization",
    "Emergency helpline escalation to human professionals",
    "Row-level security on every Supabase table for full identity isolation",
    "Google OAuth and email/password authentication via Supabase Auth"
  ],
  "publicApiSurface": [
    "POST /api/groups — create a support group",
    "GET /api/groups — list support groups",
    "GET /api/groups/[groupId] — get group details",
    "POST /api/sessions/start?groupId= — start or join a session, returns LiveKit token",
    "POST /api/sessions/end — end an active session",
    "POST /api/sessions/recording — save a session audio recording",
    "POST /api/journal — create a journal entry",
    "PATCH /api/journal — toggle include_in_analysis flag on a journal entry",
    "DELETE /api/journal?id= — delete a journal entry",
    "POST /api/transcribe — transcribe an audio recording via Groq Whisper",
    "POST /api/analyze — run AI wellbeing analysis on a transcript",
    "GET /auth/callback — Supabase OAuth callback handler",
    "GET /auth/logout — sign-out route",
    "getCurrentUser() — lib/auth/helpers",
    "getCurrentProfessional() — lib/auth/helpers",
    "requireUser() — lib/auth/helpers",
    "requireProfessional() — lib/auth/helpers",
    "generateParticipantToken() — lib/livekit/server",
    "createLiveKitRoom() — lib/livekit/server",
    "transcribeAudio() — lib/ai/stt",
    "analyzeTranscript() — lib/ai/analysis",
    "getUserTranscriptHistory() — lib/ai/analysis"
  ]
}
